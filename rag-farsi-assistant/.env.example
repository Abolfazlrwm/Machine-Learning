# Persian RAG assistant — environment template
# Copy to .env (or export the variables) to override the defaults.
# Every variable is read by src/config.py::RAGConfig.from_env()

# --- Corpus / index ---------------------------------------------------
# RAG_DATA_DIR=data
# RAG_INDEX_DIR=storage

# --- Chunking ---------------------------------------------------------
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=150

# --- Retrieval --------------------------------------------------------
# RAG_TOP_K=4
# RAG_MMR_LAMBDA=0.7
# retrieval mode: "hybrid" (BM25 + dense via RRF, recommended)
#                 | "dense" (embeddings + MMR) | "sparse" (BM25 only)
# RAG_RETRIEVAL_MODE=hybrid
# reciprocal rank fusion constant + BM25 (Okapi) constants
# RAG_RRF_K=60
# RAG_BM25_K1=1.5
# RAG_BM25_B=0.75
# optional re-ranking: "none" | "noop" | "cross-encoder" (needs sentence-transformers)
# RAG_RERANKER=none

# --- Embeddings -------------------------------------------------------
# backend: "sentence-transformers" (real) | "fake" (hash-based, zero deps)
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Generation -------------------------------------------------------
# provider: "ollama" (local, free) | "openai" (any OpenAI-compatible API)
RAG_PROVIDER=ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1

# For OpenAI-compatible APIs (OpenAI, OpenRouter, Groq, ...)
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Query understanding & caching -------------------------------------
# cross-language (Persian <-> English) expansion of the lexical sub-query
# RAG_QUERY_EXPANSION=1
# exact answer cache: TTL seconds (0 = off) + LRU bound
# RAG_CACHE_TTL=600
# RAG_CACHE_MAXSIZE=128
# paraphrase-aware lookup: embed the folded question and reuse a cached
# answer when cosine similarity >= threshold — one query embedding replaces
# the whole retrieval + generation path
# RAG_SEMANTIC_CACHE=1
# RAG_SEMANTIC_CACHE_THRESHOLD=0.92

# --- Misc -------------------------------------------------------------
# RAG_TEMPERATURE=0.2
# RAG_REQUEST_TIMEOUT=120
