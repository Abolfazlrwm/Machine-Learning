# Persian RAG assistant — environment template
# Copy to .env (or export the variables) to override the defaults.
# Every variable is read by src/config.py::RAGConfig.from_env()

# --- Corpus / index ---------------------------------------------------
# RAG_DATA_DIR=data
# RAG_INDEX_DIR=storage

# --- Chunking ---------------------------------------------------------
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=150

# --- Retrieval --------------------------------------------------------
# RAG_TOP_K=4
# RAG_MMR_LAMBDA=0.7

# --- Embeddings -------------------------------------------------------
# backend: "sentence-transformers" (real) | "fake" (hash-based, zero deps)
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Generation -------------------------------------------------------
# provider: "ollama" (local, free) | "openai" (any OpenAI-compatible API)
RAG_PROVIDER=ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.1

# For OpenAI-compatible APIs (OpenAI, OpenRouter, Groq, ...)
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Misc -------------------------------------------------------------
# RAG_TEMPERATURE=0.2
# RAG_REQUEST_TIMEOUT=120
